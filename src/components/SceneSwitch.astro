<button class="scene-switch scene-control" type="button" data-season-toggle role="switch" aria-checked="false" aria-label="Summer mode" title="Switch to summer">
    <svg class="sun-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 1v2M10 17v2M1 10h2M17 10h2M3.6 3.6 5 5M15 15l1.4 1.4M3.6 16.4 5 15M15 5l1.4-1.4"/></svg>
    <svg class="snow-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M10 2v16M3.1 6l13.8 8M3.1 14l13.8-8M7 4l3 2 3-2M7 16l3-2 3 2M3.4 9l3.2-1.1-.2-3.4M16.6 11l-3.2 1.1.2 3.4M3.4 11l3.2 1.1-.2 3.4M16.6 9l-3.2-1.1.2-3.4"/></svg>
    <span class="season-label winter-label" aria-hidden="true">Winter</span>
    <span class="season-label summer-label" aria-hidden="true">Summer</span>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-season-toggle]')!;
  const sync = () => {
    const label = document.documentElement.dataset.season === 'sun' ? 'Switch to winter' : 'Switch to summer';
    button.setAttribute('aria-checked', String(document.documentElement.dataset.season === 'sun'));
    button.title = label;
  };
  sync();
  button.addEventListener('click', () => {
    const season = document.documentElement.dataset.season === 'sun' ? 'snow' : 'sun';
    document.documentElement.dataset.season = season;
    try { localStorage.setItem('piste-season', season); } catch { /* Storage is optional. */ }
    sync();
    document.dispatchEvent(new Event('piste-season-change'));
  });
</script>
<style>
  .scene-switch { width: 44px; padding: 0; flex-shrink: 0; }
  svg { width: 20px; height: 20px; }
  .snow-icon, .season-label { display: none; }
  :global([data-season="sun"]) .snow-icon { display: block; }
  :global([data-season="sun"]) .sun-icon { display: none; }
  @media (min-width: 768px) {
    .scene-switch { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 0; width: 100%; padding: 3px; }
    .scene-switch::before { content: ''; position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / 2); border-radius: 3px; background: rgb(255 255 255 / .2); transition: transform .25s ease; }
    .scene-switch svg, :global([data-season="sun"]) .scene-switch svg { display: none; }
    .season-label { display: block; position: relative; z-index: 1; padding: 8px 4px; font-size: 12px; }
    .summer-label { opacity: .65; }
    :global([data-season="sun"]) .scene-switch::before { transform: translateX(100%); }
    :global([data-season="sun"]) .winter-label { opacity: .65; }
    :global([data-season="sun"]) .summer-label { opacity: 1; }
  }
  @media (scripting: none) { .scene-switch { display: none; } }
</style>
