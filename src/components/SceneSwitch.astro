<div class="scene-switch" role="group" aria-label="Riding season">
  <button type="button" data-season-choice="snow" aria-pressed="true" title="Snowboarding in winter">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M10 2v16M3.1 6l13.8 8M3.1 14l13.8-8M7 4l3 2 3-2M7 16l3-2 3 2M3.4 9l3.2-1.1-.2-3.4M16.6 11l-3.2 1.1.2 3.4M3.4 11l3.2 1.1-.2 3.4M16.6 9l-3.2-1.1.2-3.4"/></svg>
    Winter
  </button>
  <button type="button" data-season-choice="sun" aria-pressed="false" title="Mountain biking in summer">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5"/><path d="M10 1v2M10 17v2M1 10h2M17 10h2M3.6 3.6 5 5M15 15l1.4 1.4M3.6 16.4 5 15M15 5l1.4-1.4"/></svg>
    Summer
  </button>
</div>
<script>
  const choices = document.querySelectorAll<HTMLButtonElement>('[data-season-choice]');
  const sync = () => {
    const season = document.documentElement.dataset.season || 'snow';
    choices.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.seasonChoice === season)));
  };
  sync();
  choices.forEach(button => button.addEventListener('click', () => {
    const season = button.dataset.seasonChoice!;
    if ((document.documentElement.dataset.season || 'snow') === season) return;
    document.documentElement.dataset.season = season;
    try { localStorage.setItem('piste-season', season); } catch { /* Storage is optional. */ }
    sync();
    document.dispatchEvent(new Event('piste-season-change'));
  }));
</script>
<style>
  .scene-switch { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border: 1px solid var(--mountain-front); border-radius: 6px; }
  button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 38px; padding: 0 10px; border: 0; border-radius: 3px; background: transparent; color: var(--muted); font: 500 12px var(--mono); cursor: pointer; transition: background .25s, color .25s; }
  button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
  button:hover:not([aria-pressed="true"]) { background: var(--mountain-back); color: var(--ink); }
  svg { width: 18px; height: 18px; }
  @media (scripting: none) { .scene-switch { display: none; } }
</style>
