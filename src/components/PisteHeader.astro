---
import { site } from '../data/site';
const links = [
  { label: 'Runs', href: '#runs' }, { label: 'About', href: '#about' },
  { label: 'Resume', href: site.resumeWeb }, { label: 'Contact', href: '#contact' },
];
---
<header class="piste-header page-pad over-hero">
  <a class="brand" href="/">{site.name}</a>
  <nav class="desktop-nav" aria-label="Main">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
  <button class="menu-trigger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  <noscript><nav class="fallback-nav" aria-label="Main">{links.map(link => <a href={link.href}>{link.label}</a>)}</nav></noscript>
</header>
<dialog id="mobile-menu" aria-label="Main menu">
  <div class="menu-content">
    <div class="menu-top">
      <a class="brand" href="/">{site.name}</a>
      <span class="menu-trigger-slot"></span>
    </div>
    <nav class="menu-nav" aria-label="Mobile main">
      {links.map((link, i) => <a href={link.href} style={`--order: ${i + 1}`}><span>0{i + 1}</span>{link.label}</a>)}
    </nav>
    <div class="menu-contact">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <div class="socials"><a href={site.linkedin}>LinkedIn</a><a href={site.github}>GitHub</a></div>
    </div>
    <svg class="menu-mountain" aria-hidden="true" viewBox="0 0 390 200">
      <circle class="menu-sun" cx="326" cy="44" r="21" fill="#B8A264"/>
      <path class="menu-moon" d="M326 22a22 22 0 1 0 22 30 24 24 0 0 1-22-30Z" fill="#748493" fill-opacity=".55"/>
      <polygon points="0,120 70,70 130,105 210,30 280,90 330,60 390,95 390,200 0,200" fill="var(--menu-mountain-back, #1C2B39)"/>
      <polygon class="menu-snow-cap" points="210,30 196,46 205,44 212,52 220,44 228,48" fill="#F4F6F8" fill-opacity="0.85"/>
      <polygon points="0,160 90,115 170,150 260,100 390,150 390,200 0,200" fill="var(--menu-mountain-front, #223344)"/>
      <g class="menu-trees" fill="#506B4E">
        <path d="m60 128-12 23h6l-12 19h36l-12-19h6ZM305 145l-10 19h5l-10 17h30l-10-17h5Z"/>
      </g>
      <g fill="#F4F6F8" fill-opacity="0.6">
        {Array.from({ length: 36 }, (_, i) => (
          <circle class="menu-flake" cx={(i * 73 + 17) % 390} cy="-8" r={.8 + (i % 4) * .35}
            opacity={.3 + (i % 5) * .12}
            style={`animation-duration: ${7 + (i % 7)}s; animation-delay: -${(i * 1.7) % 13}s`}/>
        ))}
      </g>
    </svg>
  </div>
</dialog>
<script>
  import { scrollToAnchor } from '../scripts/scroll';
  const header = document.querySelector<HTMLElement>('.piste-header')!;
  const hero = document.querySelector<HTMLElement>('.hero');
  const syncHeaderColor = () => {
    const summer = document.documentElement.dataset.season === 'sun';
    const color = header.classList.contains('over-hero') ? '#CBE8F8' : (summer ? '#F6F4E9' : '#F4F6F8');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color);
  };
  if (hero) {
    // Change surface as the hero passes the bottom edge of the fixed mobile header.
    let observer: IntersectionObserver;
    const observeHero = () => {
      observer?.disconnect();
      observer = new IntersectionObserver(([entry]) => {
        header.classList.toggle('over-hero', entry.isIntersecting);
        syncHeaderColor();
      }, { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` });
      observer.observe(hero);
    };
    new ResizeObserver(observeHero).observe(header);
  }
  document.addEventListener('piste-season-change', syncHeaderColor);
  syncHeaderColor();
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger')!;
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu')!;
  let scrollY = 0;
  const notify = () => document.dispatchEvent(new Event('piste-menu-change'));
  const home = document.createComment('menu trigger');
  trigger.before(home);
  const slot = menu.querySelector('.menu-trigger-slot')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let closing = false;
  let closeTimer: ReturnType<typeof setTimeout>;
  const closeMenu = () => {
    if (!menu.open || closing) return;
    closing = true;
    menu.classList.remove('is-open');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-label', 'Open menu');
    closeTimer = setTimeout(() => menu.close(), reducedMotion.matches ? 0 : 320);
  };
  trigger.addEventListener('click', () => {
    if (menu.open) { closeMenu(); return; }
    scrollY = window.scrollY;
    document.body.style.top = `-${scrollY}px`;
    document.body.classList.add('menu-open');
    // Keep the same button interactive inside the modal's top layer.
    slot.append(trigger);
    menu.showModal();
    void menu.offsetWidth;
    menu.classList.add('is-open');
    trigger.setAttribute('aria-expanded', 'true');
    trigger.setAttribute('aria-label', 'Close menu');
    trigger.focus({ preventScroll: true });
    notify();
  });
  menu.addEventListener('cancel', event => { event.preventDefault(); closeMenu(); });
  menu.addEventListener('close', () => {
    clearTimeout(closeTimer);
    closing = false;
    menu.classList.remove('is-open');
    home.after(trigger);
    document.body.classList.remove('menu-open');
    document.body.style.top = '';
    window.scrollTo({ top: scrollY, behavior: 'instant' });
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-label', 'Open menu');
    trigger.focus({ preventScroll: true });
    notify();
  });
  menu.addEventListener('keydown', event => {
    if (event.key !== 'Tab') return;
    const items = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button'));
    const first = items[0];
    const last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });
  menu.querySelectorAll<HTMLAnchorElement>('a').forEach(link => {
    link.addEventListener('click', event => {
      const hash = link.getAttribute('href');
      if (hash?.startsWith('#')) {
        event.preventDefault();
        menu.addEventListener('close', () => {
          scrollToAnchor(hash);
        }, { once: true });
      }
      closeMenu();
    });
  });
  matchMedia('(min-width: 768px)').addEventListener('change', event => {
    if (event.matches && menu.open) menu.close();
  });
</script>
<style>
  .piste-header { position: absolute; top: 0; left: 0; width: 100%; z-index: 5; display: flex; justify-content: space-between; align-items: center; padding-block: 28px; gap: 20px; }
  .brand { font: 700 20px var(--display); text-decoration: none; }
  .desktop-nav { display: flex; gap: 32px; font: 13px var(--mono); text-transform: uppercase; letter-spacing: .05em; }
  .desktop-nav a { text-decoration: none; padding-block: 10px; margin-block: -10px; }
  .menu-trigger { display: none; }
  .menu-trigger:focus { outline: none; }
  .menu-trigger:focus-visible { background: color-mix(in srgb, currentColor 12%, transparent); border-radius: 4px; }
  dialog { padding: 0; border: 0; margin: 0; max-width: none; max-height: none; width: 100%; height: 100%; height: 100dvh; background: var(--ink); color: var(--bg); overflow-y: auto; overscroll-behavior: contain; }
  dialog::backdrop { background: var(--ink); }

  .menu-content { min-height: 100%; display: flex; flex-direction: column; }
  .menu-top { position: sticky; top: 0; z-index: 2; background: var(--ink); display: flex; align-items: center; justify-content: space-between; padding: 20px; }
  .menu-top .brand { font-size: 18px; }
  .menu-nav { display: flex; flex-direction: column; padding: 24px 20px 0; border-top: 1px solid #2A3A4A; }
  .menu-nav a { display: flex; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 1px solid #2A3A4A; text-decoration: none; font: 700 44px/1 var(--display); letter-spacing: -.03em; }
  .menu-nav a { opacity: 0; transform: translateY(24px); transition: opacity .24s ease, transform .32s cubic-bezier(.22, 1, .36, 1); }
  dialog.is-open .menu-nav a { opacity: 1; transform: none; transition-duration: .5s; transition-delay: calc(var(--order) * 75ms); }
  .menu-contact { opacity: 0; transform: translateY(16px); transition: opacity .2s, transform .3s; }
  dialog.is-open .menu-contact { opacity: 1; transform: none; transition-delay: .38s; }
  .menu-nav span { color: #9FB0C2; font: 13px var(--mono); }
  .menu-contact { display: flex; flex-direction: column; gap: 14px; padding: 32px 20px 0; z-index: 1; font-size: 17px; font-weight: 500; }
  .menu-contact .socials { gap: 22px; color: #C3CFDB; font-size: 12px; }
  .menu-sun, .menu-trees { display: none; }
  :global([data-season="sun"]) .menu-mountain { --menu-mountain-back: #304A38; --menu-mountain-front: #3B5840; }
  :global([data-season="sun"]) :is(.menu-moon, .menu-flake, .menu-snow-cap) { display: none; animation: none; }
  :global([data-season="sun"]) :is(.menu-sun, .menu-trees) { display: inline; }
  .menu-mountain { display: block; width: 100%; flex-shrink: 0; margin-top: auto; }
  .menu-flake { animation: menu-snow 10s linear infinite; }
  @keyframes menu-snow { from { transform: translateY(-10px); } to { transform: translate(20px, 210px); } }
  @media (max-width: 1023px) { .desktop-nav { gap: 24px; } }
  @media (max-width: 767px) {
    .piste-header { position: fixed; padding-block: 20px; background: var(--bg); border-bottom: 1px solid var(--mountain-front); transition: background-color .25s ease; }
    .piste-header.over-hero { background: var(--scene-sky, var(--bg)); }
    .brand { font-size: 18px; }
    .desktop-nav { display: none; }
    .menu-trigger { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; width: 44px; height: 44px; margin-right: -10px; background: none; border: 0; cursor: pointer; }
    .menu-trigger span { width: 22px; height: 2px; background: currentColor; border-radius: 1px; transition: transform .32s cubic-bezier(.22, 1, .36, 1), opacity .2s; }
    .menu-trigger { color: var(--ink); }
    dialog .menu-trigger { color: var(--bg); }
    .menu-trigger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu-trigger[aria-expanded="true"] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .menu-trigger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
  @media (prefers-reduced-motion: reduce) { dialog[open], dialog[open] .menu-nav a, .menu-flake { animation: none; } .menu-flake { display: none; } }
  @media (scripting: none) { .menu-trigger { display: none; } .piste-header { flex-wrap: wrap; } .fallback-nav { display: flex; gap: 20px; font-size: 13px; } }
</style>
