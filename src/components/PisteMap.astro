---
import RiderSprite from './RiderSprite.astro';
import MountainForest from './MountainForest.astro';
import SnowSpray from './SnowSpray.astro';
import { runs } from '../data/site';
const colors = Object.fromEntries(runs.map((run) => [run.slug, run.color]));
---

<div class="piste-map" data-piste>
<svg class="piste-svg" aria-hidden="true" focusable="false" viewBox="0 0 1440 900">
      <g class="mountain-sky">
        <circle cx="1300" cy="104" r="42" fill="#F2CA70"/>
        <g fill="#FFFFFF" opacity=".6">
          <path class="sky-cloud" d="M750 98c-10-22 14-38 30-27 9-31 55-27 58 4 22-4 35 9 30 23Z"/>
          <path class="sky-cloud cloud-high" d="M1112 32c-6-13 8-23 20-16 9-20 37-17 39 4 16-2 23 4 22 12Z"/>
          <g transform="translate(560 125) scale(.72)"><path class="sky-cloud cloud-high" d="M0 22c-8-18 12-32 26-22 8-27 47-23 50 3 19-3 30 8 26 19Z"/></g>
          <g transform="translate(880 16) scale(.58)"><path class="sky-cloud" d="M0 22c-8-18 12-32 26-22 8-27 47-23 50 3 19-3 30 8 26 19Z"/></g>
          <g transform="translate(1180 165) scale(.65)"><path class="sky-cloud cloud-high" d="M0 22c-8-18 12-32 26-22 8-27 47-23 50 3 19-3 30 8 26 19Z"/></g>
          <g transform="translate(1380 55) scale(.9)"><path class="sky-cloud" d="M0 22c-8-18 12-32 26-22 8-27 47-23 50 3 19-3 30 8 26 19Z"/></g>
        </g>
      </g>
      <polygon points="-10000,540 0,540 180,380 320,450 520,270 700,400 860,320 1040,170 1220,330 1440,240 10000,240 10000,900 -10000,900" fill="var(--mountain-back)"/>
      <polygon class="snow-cap" points="1040,170 1000,215 1022,208 1040,226 1062,206 1085,214" fill="#FFFFFF"/>
      <polygon class="snow-cap" points="520,270 492,300 510,296 526,312 540,296 556,302" fill="#FFFFFF"/>
      <polygon class="snow-cap" points="1440,240 1405,268 1420,266 1440,280" fill="#FFFFFF"/>
      <polygon points="-10000,660 0,660 240,540 460,600 760,490 880,560 1000,400 1180,520 1440,440 10000,440 10000,900 -10000,900" fill="var(--mountain-front)"/>
      <polygon class="snow-cap" points="760,490 734,516 750,512 766,526 780,512 796,518" fill="#FFFFFF"/>
      <MountainForest />
      <g class="winter-lift">
      <!-- lift: base station, cable, towers, cabins -->
      <path d="M1390 872 L1150 262" fill="none" stroke="#14202B" stroke-width="1.5" stroke-opacity="0.7"/>
      <g stroke="#14202B" stroke-opacity="0.7" stroke-width="2.5" stroke-linecap="round">
        <path d="M1330 718 V753 M1324 718 H1336"/>
        <path d="M1270 565 V600 M1264 565 H1276"/>
        <path d="M1210 413 V448 M1204 413 H1216"/>
      </g>
      <rect x="1376" y="866" width="30" height="16" rx="2" fill="#14202B"/>
      <rect x="1136" y="254" width="28" height="14" rx="2" fill="#14202B"/>
      <rect class="cabin" x="-7" y="-5" width="14" height="10" rx="2" fill="#14202B"/>
      <rect class="cabin" style="animation-delay: -5s" x="-7" y="-5" width="14" height="10" rx="2" fill="#14202B"/>
      <rect class="cabin" style="animation-delay: -10s" x="-7" y="-5" width="14" height="10" rx="2" fill="#14202B"/>
      <text class="lift-label" x="1176" y="250" font-family="JetBrains Mono" font-size="12" fill="#14202B" fill-opacity="0.75">LIFT · DESIGN → PRODUCTION</text>
