<!-- Set the crop before first paint, without mounting duplicate animated SVGs. -->
<script is:inline>
  (() => {
    const map = document.querySelector('[data-piste]');
    const svg = map.querySelector('svg');
    const mobile = matchMedia('(max-width: 767px)');
    const crop = () => {
      const { width, height } = map.getBoundingClientRect();
      if (!width || !height) return;
      const baseWidth = mobile.matches ? 760 : 1440;
      const baseHeight = mobile.matches ? 920 : 900;
      // Fit the entire tour without stretching riders or cropping the summit.
      const scale = Math.min(width / baseWidth, height / baseHeight);
      const viewWidth = width / scale;
      const viewHeight = height / scale;
      const x = mobile.matches ? 1040 - viewWidth / 2 : 1440 - viewWidth;
      const y = 900 - viewHeight;
      svg.setAttribute('viewBox', `${x} ${y} ${viewWidth} ${viewHeight}`);
      map.style.setProperty('--replay-left', `${((mobile.matches ? 1104 : 1080) - x) / viewWidth * 100}%`);
      map.style.setProperty('--replay-top', `${((mobile.matches ? 100 : 114) - y) / viewHeight * 100}%`);
    };
    crop();
    new ResizeObserver(crop).observe(map);
    mobile.addEventListener('change', crop);
  })();
</script>
<script>
  const map = document.querySelector<HTMLElement>('[data-piste]');
  if (map) {
    const motion = map.querySelector<HTMLButtonElement>('[data-motion]')!;
    let paused = false;
    let visible = true;
    const sync = () => {
      map.classList.toggle('paused', paused || !visible || document.hidden || !!document.querySelector('dialog[open]'));
    };
    motion.addEventListener('click', () => {
      paused = !paused;
      motion.setAttribute('aria-pressed', String(paused));
      motion.textContent = paused ? 'Resume animation' : 'Pause animation';
      sync();
    });
    map.querySelector('[data-replay]')?.addEventListener('click', () => {
      // Restart even the completed leaning animations; keep the lift and snow continuous.
      map.classList.add('restarting');
      void map.offsetWidth;
      map.classList.remove('restarting');
      paused = false;
      motion.setAttribute('aria-pressed', 'false');
      motion.textContent = 'Pause animation';
      motion.focus({ preventScroll: true });
      sync();
    });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(map);
    document.addEventListener('visibilitychange', sync);
    document.addEventListener('piste-menu-change', sync);
  }
</script>

