        <g class="sign-cb tour"><rect x="804" y="648" width="112" height="24" rx="3" fill={colors["coffeebreak"]}/><text x="814" y="664" fill="#FFFFFF">03 CoffeeBreak</text></g>
        <g class="sign-cp tour"><rect x="1095" y="648" width="150" height="24" rx="3" fill={colors["cistou-prirodou"]}/><text x="1105" y="664" fill="#FFFFFF">02 Čistou přírodou</text></g>
        <g class="sign-kt tour"><rect x="950" y="388" width="120" height="24" rx="3" fill={colors["kamtridit"]}/><text x="960" y="404" fill="#FFFFFF">01 Kamtřídit</text></g>
      </g>
      <g class="number-signs" font-family="JetBrains Mono" font-size="12">
        <g class="sign-tt tour"><circle cx="740" cy="740" r="21" fill={colors["tabletap"]} stroke="#FFFFFF" stroke-width="3"/><text x="740" y="747" text-anchor="middle" fill="#FFFFFF" font-size="20" font-weight="500">04</text></g>
        <g class="sign-cb tour"><circle cx="860" cy="660" r="21" fill={colors["coffeebreak"]} stroke="#FFFFFF" stroke-width="3"/><text x="860" y="667" text-anchor="middle" fill="#FFFFFF" font-size="20" font-weight="500">03</text></g>
        <g class="sign-cp tour"><circle cx="1170" cy="660" r="21" fill={colors["cistou-prirodou"]} stroke="#FFFFFF" stroke-width="3"/><text x="1170" y="667" text-anchor="middle" fill="#FFFFFF" font-size="20" font-weight="500">02</text></g>
