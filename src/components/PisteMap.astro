        <path d="M1040 178 C 960 240, 900 300, 920 380 S 820 540, 860 660 S 800 820, 840 900"/>
        <path d="M1040 178 C 1090 240, 1150 290, 1130 380 S 1200 540, 1170 660 S 1210 820, 1190 900"/>
        <path d="M1040 178 C 1000 260, 1080 320, 1010 400 S 980 560, 1060 660 S 1120 820, 1080 900"/>
      </g>
      <!-- runs: drawn one by one as the rider goes down them -->
      <path class="run-tt tour" d="M760 496 C 720 580, 800 660, 740 740 S 760 840, 720 900" pathLength="1" fill="none" stroke={colors["tabletap"]} stroke-width="4" stroke-linecap="round"/>
      <path class="run-cb tour" d="M1040 178 C 960 240, 900 300, 920 380 S 820 540, 860 660 S 800 820, 840 900" pathLength="1" fill="none" stroke={colors["coffeebreak"]} stroke-width="4" stroke-linecap="round"/>
