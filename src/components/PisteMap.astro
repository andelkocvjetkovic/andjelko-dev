            <ellipse cx="0" cy="15" rx="15" ry="2.5" fill="#14202B" fill-opacity="0.18"/>
            <g class="rider-flip">
            <RiderSprite />
            </g>
          </g></g>
      </g>
      <g class="rider-cb tour">
          <g class="lean"><g class="rider-size">
            <SnowSpray />
            <ellipse cx="0" cy="15" rx="15" ry="2.5" fill="#14202B" fill-opacity="0.18"/>
            <g class="rider-flip">
            <RiderSprite />
            </g>
          </g></g>
      </g>
      <g class="rider-cp tour">
          <g class="lean"><g class="rider-size">
            <SnowSpray />
            <ellipse cx="0" cy="15" rx="15" ry="2.5" fill="#14202B" fill-opacity="0.18"/>
            <g class="rider-flip">
            <RiderSprite />
