      <g font-family="JetBrains Mono" font-size="12" font-weight="500">
        <g class="fin-tt pop tour"><path d="M731 853 L725 844 L737 844 Z" fill="#14202B"/><rect x="703" y="820" width="56" height="24" rx="12" fill="#14202B"/><text x="731" y="836" text-anchor="middle" fill="#FFFFFF">Done!</text></g>
        <g class="fin-cb pop tour"><path d="M832 826 L826 817 L838 817 Z" fill="#14202B"/><rect x="796.5" y="793" width="71" height="24" rx="12" fill="#14202B"/><text x="832" y="809" text-anchor="middle" fill="#FFFFFF">Finish!</text></g>
        <g class="fin-cp pop tour"><path d="M1191 827 L1185 818 L1197 818 Z" fill="#14202B"/><rect x="1144.5" y="794" width="93" height="24" rx="12" fill="#14202B"/><text x="1191" y="810" text-anchor="middle" fill="#FFFFFF">Completed!</text></g>
        <g class="fin-kt pop tour"><path d="M1103 830 L1097 821 L1109 821 Z" fill="#14202B"/><rect x="1064" y="797" width="78" height="24" rx="12" fill="#14202B"/><text x="1103" y="813" text-anchor="middle" fill="#FFFFFF">Shipped!</text></g>
      </g>
      <!-- me, at the top: says hi, rides every run, comes back up -->
      <clipPath id="avatar-clip"><circle cx="1040" cy="92" r="28"/></clipPath>
      <g class="summit tour">
        <g transform="translate(1040 160)">
          <g class="lean"><g class="rider-size">
            <ellipse cx="0" cy="15" rx="15" ry="2.5" fill="#14202B" fill-opacity="0.18"/>
            <RiderSprite summit />
          </g></g>
        </g>
      </g>
      <g class="hello tour"><g class="avatar-size">
        <path d="M1040 136 L1033 124 L1047 124 Z" fill="#14202B"/>
        <circle cx="1040" cy="92" r="32" fill="#14202B"/>
        <image href="/avatar.jpg" x="1012" y="64" width="56" height="56" clip-path="url(#avatar-clip)" preserveAspectRatio="xMidYMid slice"/>
        <g font-family="JetBrains Mono" font-size="12">
          <g class="hi tour">
            <rect x="1080" y="80" width="120" height="24" rx="3" fill="#14202B"/>
            <text x="1090" y="96" fill="#FFFFFF">Hey, it’s me</text>
          </g>
          <g class="bye tour">
            <rect x="1080" y="68" width="160" height="42" rx="3" fill="#14202B"/>
            <text x="1090" y="84" fill="#FFFFFF">Your turn.<tspan x="1090" dy="16">Explore the runs ↓</tspan></text>
          </g>
        </g>
      </g>
      </g>
      <!-- snow -->
      <g fill="#FFFFFF" stroke="#A3B1C0" stroke-width="0.8">
        {Array.from({ length: 120 }, (_, i) => (
          <circle class="flake" cx={(i * 137 + 43) % 1440} cy="0" r={1.5 + (i % 5) * .5}
            style={`animation-duration: ${9 + (i % 13) * .45}s; animation-delay: -${((i * 1.73) % 15).toFixed(2)}s`}/>
        ))}
      </g>
    </svg>
  <button class="motion-control" type="button" data-motion data-state="playing">
    <svg class="pause-icon" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="4" height="14" rx="1"/><rect x="12" y="3" width="4" height="14" rx="1"/></svg>
    <svg class="play-icon" width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5 3.5a1 1 0 0 1 1.5-.86l10 6.5a1 1 0 0 1 0 1.72l-10 6.5A1 1 0 0 1 5 16.5Z"/></svg>
    <span data-motion-label>Pause animation</span>
  </button>
</div>

<!-- Set the crop before first paint, without mounting duplicate animated SVGs. -->
<script is:inline>
  (() => {
    const map = document.querySelector('[data-piste]');
    const svg = map.querySelector('svg');
    const mobile = matchMedia('(max-width: 767px)');
    const crop = () => {
      const { width, height } = map.getBoundingClientRect();
      if (!width || !height) return;
      const baseWidth = mobile.matches ? 760 : 1440;
      const baseHeight = mobile.matches ? 920 : 900;
      // Fit the entire tour without stretching riders or cropping the summit.
      const scale = Math.min(width / baseWidth, height / baseHeight);
      const viewWidth = width / scale;
      const viewHeight = height / scale;
      const x = mobile.matches ? 1040 - viewWidth / 2 : 1440 - viewWidth;
      const y = 900 - viewHeight;
      svg.setAttribute('viewBox', `${x} ${y} ${viewWidth} ${viewHeight}`);
    };
    crop();
    new ResizeObserver(crop).observe(map);
    mobile.addEventListener('change', crop);
  })();
</script>
<script>
  const map = document.querySelector<HTMLElement>('[data-piste]');
  if (map) {
    const motion = map.querySelector<HTMLButtonElement>('[data-motion]')!;
    let paused = false;
    let visible = true;
    const sync = () => {
      map.classList.toggle('paused', paused || !visible || document.hidden || !!document.querySelector('dialog[open]'));
    };
    let completed = false;
    const updateControl = () => {
      const label = paused || completed ? 'Start animation' : 'Pause animation';
      motion.querySelector('[data-motion-label]')!.textContent = label;
      motion.dataset.state = paused || completed ? 'paused' : 'playing';
      motion.setAttribute('aria-label', completed ? 'Start animation again' : label);
    };
    map.querySelector('.run-kt')?.addEventListener('animationend', () => {
      completed = true;
      paused = true;
      updateControl();
      sync();
    });
    document.addEventListener('piste-season-change', () => {
      map.classList.add('restarting');
      void map.offsetWidth;
      map.classList.remove('restarting');
      if (completed) paused = false;
      completed = false;
      updateControl();
      sync();
    });
    motion.addEventListener('click', () => {
      if (completed) {
        map.classList.add('restarting');
        void map.offsetWidth;
        map.classList.remove('restarting');
        completed = false;
        paused = false;
      } else {
        paused = !paused;
      }
      updateControl();
      sync();
    });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(map);
    document.addEventListener('visibilitychange', sync);
    document.addEventListener('piste-menu-change', sync);
  }
</script>

<style>
.summer-trails { display: none; }
:global([data-season="sun"]) .summer-trails { display: inline; }
:global([data-season="sun"]) .snow-cap { fill: #B9CDB9; }
:global([data-season="sun"]) :is(.flake, .winter-lift) { display: none; }
:global([data-season="sun"]) .flake, :global([data-season="sun"]) .cabin { animation: none; }

.sky-cloud { animation: cloud-drift 18s ease-in-out infinite alternate; }
.cloud-high { animation-duration: 24s; animation-delay: -8s; }
@keyframes cloud-drift {
  from { transform: translate(-16px, 0); }
  to { transform: translate(22px, -3px); }
}
@keyframes snow{0%{transform:translate(0,-40px);opacity:0}10%{opacity:0.9}100%{transform:translate(30px,900px);opacity:0}}
@keyframes lean{0%,100%{transform:rotate(-14deg)}17%{transform:rotate(12deg)}33%{transform:rotate(-12deg)}50%{transform:rotate(14deg)}67%{transform:rotate(-12deg)}83%{transform:rotate(12deg)}}
@keyframes cabin{0%{offset-distance:0%;opacity:0}5%{opacity:1}95%{opacity:1}100%{offset-distance:100%;opacity:0}}
.lean{animation:lean 3.5s ease-in-out 1;transform-box:view-box;transform-origin:0 12px}
/* One airborne rotation midway through each descent; spray stays on the snow. */
.rider-flip { animation: rider-flip 3.5s linear both; animation-delay: var(--ride-start); transform-box: view-box; transform-origin: 0 4px; }
@keyframes rider-flip {
  0%, 38% { transform: translateY(0) rotate(0deg); }
  46% { transform: translateY(-20px) rotate(-50deg); }
  56% { transform: translateY(-38px) rotate(-180deg); }
  66% { transform: translateY(-22px) rotate(-300deg); }
  74% { transform: translateY(0) rotate(-360deg) scaleY(1); }
  77% { transform: translateY(2px) rotate(-360deg) scaleY(.86); }
  82%, 100% { transform: translateY(0) rotate(-360deg) scaleY(1); }
}
.flake{animation:snow 11s linear infinite}
.cabin{offset-path:path('M1390 872 L1150 262');offset-rotate:0deg;animation:cabin 15s linear infinite}
.tour{animation-duration:22.5s;animation-iteration-count:1;animation-fill-mode:forwards;animation-timing-function:linear}
.pop{transform-box:fill-box;transform-origin:50% 100%}
.run-tt{stroke-dasharray:1 1;animation-name:draw-tt}
@keyframes draw-tt{0%,13.33%{stroke-dashoffset:1}28.89%{stroke-dashoffset:0.07}33.33%,100%{stroke-dashoffset:0}}
.sign-tt{animation-name:sign-tt}
@keyframes sign-tt{0%,14.67%{opacity:0}17.33%,100%{opacity:1}}
.rider-tt{--ride-start:3s;offset-path:path('M760 496 C 720 580, 800 660, 740 740 S 760 840, 720 900');offset-rotate:0deg;animation-name:ride-tt}
.rider-tt .lean{animation-delay:var(--ride-start)}
@keyframes ride-tt{0%,13.33%{offset-distance:0%;opacity:0}14.67%{opacity:1}28.89%{offset-distance:93%;opacity:1}32.44%{offset-distance:93%;opacity:1}33.33%,100%{offset-distance:93%;opacity:0}}
.fin-tt{animation-name:fin-tt}
@keyframes fin-tt{0%,28.89%{opacity:0;transform:scale(0.4)}30.00%,32.44%{opacity:1;transform:scale(1)}33.33%,100%{opacity:0;transform:scale(0.4)}}
.run-cb{stroke-dasharray:1 1;animation-name:draw-cb}
@keyframes draw-cb{0%,33.33%{stroke-dashoffset:1}48.89%{stroke-dashoffset:0.07}53.33%,100%{stroke-dashoffset:0}}
.sign-cb{animation-name:sign-cb}
@keyframes sign-cb{0%,34.67%{opacity:0}37.33%,100%{opacity:1}}
.rider-cb{--ride-start:7.5s;offset-path:path('M1040 178 C 960 240, 900 300, 920 380 S 820 540, 860 660 S 800 820, 840 900');offset-rotate:0deg;animation-name:ride-cb}
.rider-cb .lean{animation-delay:var(--ride-start)}
@keyframes ride-cb{0%,33.33%{offset-distance:0%;opacity:0}34.67%{opacity:1}48.89%{offset-distance:93%;opacity:1}52.44%{offset-distance:93%;opacity:1}53.33%,100%{offset-distance:93%;opacity:0}}
.fin-cb{animation-name:fin-cb}
@keyframes fin-cb{0%,48.89%{opacity:0;transform:scale(0.4)}50.00%,52.44%{opacity:1;transform:scale(1)}53.33%,100%{opacity:0;transform:scale(0.4)}}
.run-cp{stroke-dasharray:1 1;animation-name:draw-cp}
@keyframes draw-cp{0%,53.33%{stroke-dashoffset:1}68.89%{stroke-dashoffset:0.07}73.33%,100%{stroke-dashoffset:0}}
.sign-cp{animation-name:sign-cp}
@keyframes sign-cp{0%,54.67%{opacity:0}57.33%,100%{opacity:1}}
.rider-cp{--ride-start:12s;offset-path:path('M1040 178 C 1090 240, 1150 290, 1130 380 S 1200 540, 1170 660 S 1210 820, 1190 900');offset-rotate:0deg;animation-name:ride-cp}
.rider-cp .lean{animation-delay:var(--ride-start)}
@keyframes ride-cp{0%,53.33%{offset-distance:0%;opacity:0}54.67%{opacity:1}68.89%{offset-distance:93%;opacity:1}72.44%{offset-distance:93%;opacity:1}73.33%,100%{offset-distance:93%;opacity:0}}
.fin-cp{animation-name:fin-cp}
@keyframes fin-cp{0%,68.89%{opacity:0;transform:scale(0.4)}70.00%,72.44%{opacity:1;transform:scale(1)}73.33%,100%{opacity:0;transform:scale(0.4)}}
.run-kt{stroke-dasharray:1 1;animation-name:draw-kt}
@keyframes draw-kt{0%,73.33%{stroke-dashoffset:1}88.89%{stroke-dashoffset:0.07}93.33%,100%{stroke-dashoffset:0}}
.sign-kt{animation-name:sign-kt}
@keyframes sign-kt{0%,74.67%{opacity:0}77.33%,100%{opacity:1}}
.rider-kt{--ride-start:16.5s;offset-path:path('M1040 178 C 1000 260, 1080 320, 1010 400 S 980 560, 1060 660 S 1120 820, 1080 900');offset-rotate:0deg;animation-name:ride-kt}
.rider-kt .lean{animation-delay:var(--ride-start)}
@keyframes ride-kt{0%,73.33%{offset-distance:0%;opacity:0}74.67%{opacity:1}88.89%{offset-distance:93%;opacity:1}92.44%{offset-distance:93%;opacity:1}93.33%,100%{offset-distance:93%;opacity:0}}
.fin-kt{animation-name:fin-kt}
@keyframes fin-kt{0%,88.89%{opacity:0;transform:scale(0.4)}90.00%,92.44%{opacity:1;transform:scale(1)}93.33%,100%{opacity:0;transform:scale(0.4)}}
.summit{animation-name:summit}.summit .lean{animation:none}
@keyframes summit{0%{opacity:0}1.33%,12.00%{opacity:1}13.33%,93.33%{opacity:0}95.11%,100%{opacity:1}}
.hello{animation-name:hello}
@keyframes hello {
  0%, 1% { opacity: 0; transform: translateY(8px); }
  4%, 11.11% { opacity: 1; transform: translateY(0); }
  13%, 95% { opacity: 0; transform: translateY(8px); }
  98%, 100% { opacity: 1; transform: translateY(0); }
}
.bye{animation-name:bye}.hi{animation-name:hi}
@keyframes hi{0%,13.33%{opacity:1}13.38%,100%{opacity:0}}
@keyframes bye{0%,13.33%{opacity:0}13.38%,100%{opacity:1}}

.piste-map { position: absolute; inset: 0; overflow: hidden; }
.piste-svg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
.number-signs { display: none; }
.motion-control { position: absolute; z-index: 3; right: 16px; bottom: 14px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 0 15px; border: 1px solid rgb(255 255 255 / .2); border-radius: 6px; font: 600 12px var(--mono); color: #FFFFFF; background: var(--ink); box-shadow: 0 3px 10px rgb(0 0 0 / .12); cursor: pointer; transition: background .2s, transform .2s; }
.motion-control:hover { background: #3D5648; transform: translateY(-1px); }
.motion-control svg { flex-shrink: 0; }
.motion-control .play-icon, .motion-control[data-state="paused"] .pause-icon { display: none; }
.motion-control[data-state="paused"] .play-icon { display: block; }
/* The bike's front wheel follows the trail tangent, instead of facing across it. */
:global([data-season="sun"]) :is(.rider-tt, .rider-cb, .rider-cp, .rider-kt) { offset-rotate: auto -90deg; }
:global([data-season="sun"]) .lean { animation: none; transform: none; }
:global([data-season="sun"]) .rider-flip { animation-name: bike-hop; }
@keyframes bike-hop {
  0%, 38%, 80%, 100% { transform: translateY(0) rotate(0); }
  52% { transform: translateY(-10px) rotate(-3deg); }
  65% { transform: translateY(-5px) rotate(2deg); }
  74% { transform: translateY(1px) rotate(0); }
